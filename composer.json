{
    "name": "shinobiphp/shinobi",
    "description": "Shinobi enterprise capability runtime",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "openswoole/core": "^26.2",
        "symfony/messenger": "^8.1",
        "shinobiphp/codejitsu": "^1.0",
        "nette/neon": "^3.4"
    },
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Shinobi\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Shinobi PHP",
            "email": "shinobiphp@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../codejitsu",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../codejitsu/packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": "phpunit",
        "shinobi": "php bin/shinobi"
    },
    "config": {
        "bin-dir": "./bin/",
        "vendor-dir": "./lib/",
        "allow-plugins": {
            "codejitsu/composer-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    }
}
